&CONTROL
calculation = 'scf',
  prefix      = 'graphene',
  outdir      = './tmp/',
  pseudo_dir  = '../../pseudos/',
  tprnfor = .true.,
  tstress = .true.,
  forc_conv_thr = 1.0d-6,
  etot_conv_thr = 1.0d-8,
  restart_mode = 'from_scratch',
  verbosity = 'high',
  wf_collect = .TRUE.,
/

&SYSTEM
  ibrav = 0,
  nat  = 2,
  ntyp = 1,
  ecutwfc = 70.0,
  ecutrho = 700.0,
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.002
/

&ELECTRONS
  conv_thr = 1e-08
  electron_maxstep = 200
  mixing_beta = 0.5
  mixing_mode = 'plain'
  scf_must_converge = .TRUE.
  startingwfc = 'random'
/

ATOMIC_SPECIES
  C 12.011 C.pbe-n-rrkjus_psl.0.1.UPF

K_POINTS {automatic}
  12 12 1 0 0 0

CELL_PARAMETERS {angstrom}
   2.467240978   0.000000000  -0.000000000
  -1.233620489   2.136693364   0.000000000
  -0.000000000   0.000000000   15

ATOMIC_POSITIONS {angstrom}
C  0.000000000         0.000000000         0.000000000
C  0.000000000         1.4244623188        0.000000000

