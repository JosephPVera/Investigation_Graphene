&CONTROL
calculation = 'nscf'
  prefix      = 'ZGNR',
  outdir      = '../tmp/',
  pseudo_dir  = '../../../PP_C/',
  tprnfor = .true.,
  tstress = .true.,
  forc_conv_thr = 1.0d-6,
  etot_conv_thr = 1.0d-8,
  restart_mode = 'restart',
  verbosity = 'high',
  wf_collect = .TRUE.,
/

&SYSTEM
  ibrav = 0,
  nat  = 22,
  ntyp = 2,
  ecutwfc = 70.0,
  ecutrho = 700.0,
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.002
/

&ELECTRONS
  conv_thr = 1e-06
  electron_maxstep = 200
  mixing_beta = 0.5
  mixing_mode = 'plain'
  scf_must_converge = .TRUE.
  startingwfc = 'random'
  diago_david_ndim = 8
/

ATOMIC_SPECIES
C 12.011 C.pbe-n-kjpaw_psl.1.0.0.UPF
H 1.0079 H.pbe-kjpaw_psl.1.0.0.UPF

