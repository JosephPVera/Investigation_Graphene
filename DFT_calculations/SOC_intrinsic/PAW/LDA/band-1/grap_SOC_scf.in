&CONTROL
calculation = 'scf'
  prefix      = 'graphene',
  outdir      = './tmp/',
  pseudo_dir  = '../../../pseudos/',
  tprnfor = .true.,
  tstress = .true.,
  forc_conv_thr = 1.0d-6,
  etot_conv_thr = 1.0d-8,
  restart_mode = 'from_scratch',
  !verbosity = 'high',
  wf_collect = .TRUE.,
/

&SYSTEM
  ibrav = 0,
  nat  = 2,
  ntyp = 1,
  ecutwfc = 70.0,
  ecutrho = 700.0,
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.002
  noncolin=.true.
  lspinorb=.true.
  nosym = .true.
/

&ELECTRONS
  conv_thr = 1e-08
  electron_maxstep = 200
  mixing_beta = 0.1
  mixing_mode = 'plain'
  scf_must_converge = .TRUE.
  startingwfc = 'random'
  diagonalization = 'david'
  diago_david_ndim = 8
  !diago_thr_init = 1e-02
/

ATOMIC_SPECIES
  C 12.011 C.rel-pz-n-kjpaw_psl.0.1.UPF

K_POINTS {automatic}
  12 12 1 0 0 0

CELL_PARAMETERS {angstrom}
  2.446039531    -0.000000000   0.000000000
  -1.223019765   2.118332372    0.000000000
  -0.000000000   -0.000000000   14.947164432

ATOMIC_POSITIONS {angstrom}
C     -0.0000000000       -0.0000000000       -0.0000000000
C     -0.0000000000       1.4122216570        0.0000000000

