&CONTROL
calculation = 'nscf'
forc_conv_thr = 0.0004
outdir = './output/'
prefix = 'graphene'
pseudo_dir = '../../pseudos/'
restart_mode = 'restart'
verbosity = 'high'
wf_collect = .TRUE.
tstress = .true.
tprnfor = .true.
/

&SYSTEM
ecutrho = 400
ecutwfc = 40
ibrav = 0
nat = 2
ntyp = 1
occupations = 'smearing'
smearing = 'gaussian'
degauss = 0.002
/

&ELECTRONS
conv_thr = 1e-06
electron_maxstep = 200
mixing_beta = 0.5
mixing_mode = 'plain'
scf_must_converge = .TRUE.
startingwfc = 'random'
/

ATOMIC_SPECIES
C 12.011 C.pbe-n-kjpaw_psl.1.0.0.UPF

K_POINTS {automatic}
150 150 1 0 0 0

CELL_PARAMETERS {angstrom}
2.4661856206     0.0000000000    0.0000000000
-1.2330928103    2.1357793979    0.0000000000
0.0000000000     0.0000000000    14.7735222095

ATOMIC_POSITIONS {angstrom}
C     0.000000000         0.000000000         0.000000000
C     0.000000000         1.426426561         0.000000000
