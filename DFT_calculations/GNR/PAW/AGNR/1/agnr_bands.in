&CONTROL
calculation = 'bands'
  prefix      = 'AGNR',
  outdir      = './tmp/',
  pseudo_dir  = '../../../pseudos/',
  tprnfor = .true.,
  tstress = .true.,
  forc_conv_thr = 1.0d-6,
  etot_conv_thr = 1.0d-8,
  restart_mode = 'restart',
  verbosity = 'high',
  wf_collect = .TRUE.,
/

&SYSTEM
  ibrav = 0,
  nat  = 4,
  ntyp = 1,
  ecutwfc = 70.0,
  ecutrho = 700.0,
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.002
  nbnd = 16
/

&ELECTRONS
  conv_thr = 1e-08
  electron_maxstep = 200
  mixing_beta = 0.5
  mixing_mode = 'plain'
  scf_must_converge = .TRUE.
  startingwfc = 'random'
/

