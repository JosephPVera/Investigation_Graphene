&INPUTPP
    prefix='graphene'
    outdir='../tmp'
    plot_num=0
/
&PLOT
   nfile=1
   filepp(1)='charge'
   weight(1)=1.0
   iflag=2
   output_format=0
   e1(1)=1.0, e1(2)=0.0, e1(3)=0.0
   e2(1)=0.0, e2(2)=1.0, e2(3)=0.0
   x0(1)=0.0, x0(2)=0.0, x0(3)=0.0
   nx=500
   ny=500
   fileout='grap_chg_2d.dat'
/
