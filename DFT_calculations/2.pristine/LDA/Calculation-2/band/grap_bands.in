&CONTROL
calculation = 'bands'
  prefix      = 'graphene',
  outdir      = '../tmp/',
  pseudo_dir  = '../../PP_C/',
  tprnfor = .true.,
  tstress = .true.,
  forc_conv_thr = 1.0d-6,
  etot_conv_thr = 1.0d-8,
  restart_mode = 'restart',
  verbosity = 'high',
  wf_collect = .TRUE.,
/

&SYSTEM
  ibrav = 0,
  nat  = 2,
  ntyp = 1,
  ecutwfc = 70.0,
  ecutrho = 700.0,
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.002
  nbnd = 16
/

&ELECTRONS
  conv_thr = 1e-08
  electron_maxstep = 200
  mixing_beta = 0.5
  mixing_mode = 'plain'
  scf_must_converge = .TRUE.
  startingwfc = 'random'
/

ATOMIC_SPECIES
C 12.011 C.pz-n-kjpaw-LDA.UPF

