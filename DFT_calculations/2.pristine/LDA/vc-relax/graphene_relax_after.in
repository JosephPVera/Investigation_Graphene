&CONTROL
  calculation = 'vc-relax',
  prefix      = 'graphene',
  outdir      = './tmp/',
  pseudo_dir  = '../../pseudos/',
  tprnfor = .true.,
  tstress = .true.,
  forc_conv_thr = 1.0d-6,
  etot_conv_thr = 1.0d-8,
/

&SYSTEM
  ibrav = 0,
  nat  = 2,
  ntyp = 1,
  ecutwfc = 70.0,
  ecutrho = 700.0,
!  occupations = 'smearing',
!  smearing = 'gaussian',
!  degauss = 0.01,
/

&ELECTRONS
  conv_thr = 1.0d-8
/

&IONS
/

&CELL
  cell_dofree='all'
/

ATOMIC_SPECIES
  C  12.0107 C.pz-n-kjpaw-LDA.UPF

K_POINTS automatic
  12 12 1   0 0 0
  
CELL_PARAMETERS {angstrom}
  2.446039531    -0.000000000   0.000000000
  -1.223019765   2.118332372    0.000000000
  -0.000000000   -0.000000000   14.947164432

ATOMIC_POSITIONS {angstrom}
C     -0.0000000000       -0.0000000000       -0.0000000000
C     -0.0000000000       1.4122216570        0.0000000000
