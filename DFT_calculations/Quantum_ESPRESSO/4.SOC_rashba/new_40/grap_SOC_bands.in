&CONTROL
calculation = 'bands'
  prefix      = 'graphene',
  outdir      = './tmp/',
  pseudo_dir  = '../../../pseudos/',
  tprnfor = .true.,
  tstress = .true.,
  forc_conv_thr = 1.0d-6,
  etot_conv_thr = 1.0d-8,
  restart_mode = 'restart',
  verbosity = 'high',
  wf_collect = .TRUE.,
  tefield       = .true.,
  dipfield      = .true.,
/

&SYSTEM
  ibrav = 0,
  nat  = 2,
  ntyp = 1,
  ecutwfc = 70.0,
  ecutrho = 700.0,
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.002
  nbnd = 16
  noncolin=.true.
  lspinorb=.true.
  nosym = .true.
  edir  = 3
  emaxpos = 0.9
  eopreg  = 0.05
  eamp  = 0.001944691
/

&ELECTRONS
  conv_thr = 1e-08
  electron_maxstep = 200
  mixing_beta = 0.1
  mixing_mode = 'plain'
  scf_must_converge = .TRUE.
  startingwfc = 'random'
  diagonalization = 'david'
  diago_david_ndim = 8
  !diago_thr_init = 1e-02
/

ATOMIC_SPECIES
  C 12.011 C.rel-pbe-n-kjpaw_psl.1.0.0.UPF

K_POINTS {crystal_b}
4
0.0000000000     0.0000000000     0.0000000000     500  ! Gamma
0.3333333333     0.3333333333     0.0000000000     500  ! K
0.5000000000     0.0000000000     0.0000000000     500  ! M
0.0000000000     0.0000000000     0.0000000000     0     ! Gamma

CELL_PARAMETERS {angstrom}
   2.467240978   0.000000000  -0.000000000
  -1.233620489   2.136693364   0.000000000
  -0.000000000   0.000000000   15

ATOMIC_POSITIONS {angstrom}
C  0.000000000         0.000000000         7.500000000
C  0.000000000         1.4244623188        7.500000000
